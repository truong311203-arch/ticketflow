# Application Environment
APP_ENV=development
PORT=8080
LOG_LEVEL=debug

# HTTP Server Timeouts
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s

# Database Configuration (for upcoming migration & repository setup)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ticketflow_user
DB_PASSWORD=ticketflow_secret
DB_NAME=ticketflow_db
DB_SSLMODE=disable
DB_SCHEMA=core